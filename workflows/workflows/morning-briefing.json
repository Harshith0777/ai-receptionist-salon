      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { message: '☀️ Good morning! No appointments scheduled for today at Glow Salon. Enjoy the free day! 🌿' } }];\n}\n\nlet message = `☀️ Good morning! Here's today's schedule at Glow Salon:\\n\\n`;\n\nitems.forEach((item, index) => {\n  const title = item.json.summary || 'Appointment';\n  const start = item.json.start?.dateTime || item.json.start?.date || '';\n  \n  // Convert ISO time to readable IST time\n  const time = start ? new Date(start).toLocaleTimeString('en-IN', {\n    timeZone: 'Asia/Kolkata',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: true\n  }) : 'Time not set';\n\n  message += `${index + 1}. ${title} → ${time}\\n`;\n});\n\nmessage += `\\nTotal appointments today: ${items.length} 💪`;\n\nreturn [{ json: { message } }];"
      },
